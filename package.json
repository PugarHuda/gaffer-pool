{
  "name": "sehat",
  "version": "0.1.0",
  "description": "Sehat — offline-first family health assistant. RAG over family health documents, voice Q&A with MedPsy-4B, OCR ingestion, and P2P delegated inference to budget phones. 100% on-device via QVAC SDK.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "smoke": "node src/smoke-test.js",
    "test:gpu": "node src/gpu-test.js",
    "test:medgemma": "node src/medgemma-test.js",
    "demo:rag": "node src/demo-rag.js",
    "demo:analyst": "node src/demo-analyst.js",
    "demo:pool": "node src/demo-pool.js",
    "demo:voice": "node src/demo-voice.js",
    "demo:ocr": "node src/ocr-ingest.js",
    "demo:agent": "node src/demo-agent.js",
    "demo:translate": "node src/demo-translate.js",
    "test:injection": "node src/test-injection.js",
    "demo:vision": "node src/demo-vision.js",
    "demo:finetune": "node src/demo-finetune.js",
    "genesis:prepare": "node src/genesis-prepare.js",
    "demo:finetune:genesis": "node src/demo-finetune-genesis.js",
    "profile": "node src/profile-run.js",
    "provider": "node src/provider.js",
    "delegate": "node src/delegate-test.js",
    "start": "node src/server.js",
    "desktop": "electron electron/main.cjs",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": [
    "qvac",
    "edge-ai",
    "local-ai",
    "medpsy",
    "rag",
    "p2p",
    "health"
